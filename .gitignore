# .gitignore for PT to RKNN Tool

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
*.egg-info/
dist/
build/

# 上传和输出目录
uploads/*
!uploads/.gitkeep
output/*
!output/.gitkeep

# 校准数据集（全部忽略，不推送任何内容）
calibration_data/

# Flask
instance/
.webassets-cache

# 环境变量（含敏感配置）
.env

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# 操作系统
.DS_Store
Thumbs.db

# 日志
*.log

# 临时文件
*.tmp
*.temp

# ONNX调试文件
check*.onnx
